rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User data snapshots (cloud sync) — same owner-only rule.
      match /data/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Lesson slides — owner-only.
      match /slides/{slideId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Activity library is read-only for any authenticated user.
    // Writes only happen via the Admin SDK seed script — never from the client.
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Waitlist — anyone can submit an email, no one can read from the client.
    match /waitlist/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Catch-all: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
