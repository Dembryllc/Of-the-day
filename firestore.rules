rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User data snapshots (cloud sync) — same owner-only rule.
      match /data/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Activity library is read-only for any authenticated user.
    // Writes only happen via the Admin SDK seed script — never from the client.
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Catch-all: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
