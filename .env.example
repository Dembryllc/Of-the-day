# ─── Firebase (Phase 3) ────────────────────────────────────────────────────────
# All VITE_ vars are safe to expose in frontend bundle.
# Firebase credentials come from Firebase Console → Project Settings → Web App.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Stripe (Phase 5) ─────────────────────────────────────────────────────────
# Publishable key is safe for frontend. NEVER put secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_MONTHLY_PRICE_ID=
VITE_STRIPE_ANNUAL_PRICE_ID=

# ─── Stripe (Firebase Functions only — never in frontend) ────────────────────
# Set these in Firebase Functions config, NOT here:
#   firebase functions:config:set stripe.secret_key="sk_live_..."
#   firebase functions:config:set stripe.webhook_secret="whsec_..."
#
# STRIPE_SECRET_KEY=       ← server-side only
# STRIPE_WEBHOOK_SECRET=   ← server-side only
