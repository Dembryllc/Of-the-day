# Firebase Cloud Functions environment variables
# Copy this file to functions/.env and fill in your values.
# This file is gitignored — NEVER commit functions/.env

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (email delivery) ───────────────────────────────────────────────────
# Sign up at resend.com → API Keys → Create API Key
# Verify your sending domain at resend.com → Domains → Add Domain
# Until your domain is verified, use from: 'OfTheDay <onboarding@resend.dev>'
# and update EMAIL_FROM in functions/index.js accordingly.
RESEND_API_KEY=re_...
