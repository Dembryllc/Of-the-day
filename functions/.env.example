# Firebase Cloud Functions environment variables
# Copy this file to functions/.env and fill in your values.
# This file is gitignored — NEVER commit functions/.env

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...

# ── Mailgun (email delivery) ──────────────────────────────────────────────────
# Sign up at mailgun.com → Sending → Domains → Add Domain
# MAILGUN_API_KEY: API key from mailgun.com → Settings → API Keys
# MAILGUN_DOMAIN: your verified sending domain (e.g. mg.oftheday.net or oftheday.net)
# Note: US region uses api.mailgun.net; EU region needs the EU endpoint configured in code
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.oftheday.net

# ── Anthropic (Lesson Slide Creator AI) ──────────────────────────────────────
# Sign up at console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...
